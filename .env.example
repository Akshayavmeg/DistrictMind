# DistrictMind — development environment template.
# Copy to a file named .env in the repository root and fill in LOCAL values.
# NEVER commit .env. Values below are placeholders or safe development defaults only.

# --- API / backend (read by backend/app/core/config.py) ---
APP_ENV=development
API_PREFIX=/api/v1
SERVICE_NAME=districtmind-backend
# DEVELOPMENT STUB ONLY — NOT REAL AUTHENTICATION. Rejected unless APP_ENV=development.
AUTH_MODE=development
# Explicit origins allowed to call the API. Comma-separated, no wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (read by Vite; copy this line into frontend/.env.local) ---
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Database (NOT USED in development Step 1; PostgreSQL/PostGIS not yet validated) ---
DATABASE_URL=postgresql+psycopg://districtmind:CHANGE_ME_DEV_ONLY@127.0.0.1:5432/districtmind_dev
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY

# --- Secrets (NOT USED in Step 1) ---
SECRET_KEY=CHANGE_ME_DEV_ONLY

# --- AI (NOT USED in Step 1; AI is not implemented) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=llama3.2:3b

# --- RAG (NOT USED in Step 1; RAG is not implemented) ---
CHROMA_PATH=./data/chroma
